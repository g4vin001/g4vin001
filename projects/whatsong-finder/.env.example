# Set these as server-side secrets/settings in your deployment. Never use NEXT_PUBLIC_ for keys.
AUDD_API_TOKEN=
GLOBAL_DAILY_SCAN_LIMIT=100
VISITOR_DAILY_SCAN_LIMIT=5
IP_DAILY_SCAN_LIMIT=20
# Cumulative provider request ceiling. Does not reset with daily cleanup.
# Raise only after reviewing provider usage and the site's funding.
TOTAL_SCAN_LIMIT=300
# Your real AdSense ID (ca-pub- followed by 16 digits). Verification only;
# ad serving remains a separate step after approval and consent setup.
ADSENSE_CLIENT_ID=
# Optional, real destinations only. Empty values hide the corresponding UI.
SUPPORT_URL=
SPONSOR_LABEL=
SPONSOR_URL=
SPONSOR_DESCRIPTION=
